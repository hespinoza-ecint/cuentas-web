# Ejemplo de nginx para produccion con el front y la API en maquinas distintas.
#
#   Front (esta maquina):  sirve dist/ del build de cuentas-web
#   API   (otra maquina):  recibe /api y /health por proxy interno
#   MySQL (otra maquina):  solo la API se conecta (nada que configurar aqui)
#
# Ajusta estas DOS lineas:
#   server_name app.tudominio.com;
#   set $api_backend http://10.0.0.20:3000;   # IP privada de la maquina de la API
#
# Instalacion:
#   1) npm.cmd run build                 (en cuentas-web)
#   2) copiar dist/ a /var/www/cuentas-web/dist
#   3) sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/cuentas
#   4) sudo nginx -t && sudo systemctl reload nginx
#   5) HTTPS: sudo certbot --nginx -d app.tudominio.com

server {
    listen 80;
    server_name app.tudominio.com;

    root /var/www/cuentas-web/dist;
    index index.html;

    # IP privada de la maquina de la API
    set $api_backend http://10.0.0.20:3000;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # La cookie del refresh (SameSite=Strict) viaja al mismo origen:
    # el navegador solo habla con este dominio y nginx reenvia a la API.
    location /api/ {
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass $api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # El service worker nunca se cachea (si no, la PWA no se actualiza)
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Los assets llevan hash en el nombre: cache agresivo
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: rutas del cliente
    location / {
        try_files $uri /index.html;
    }
}
