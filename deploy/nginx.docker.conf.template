# Plantilla nginx para el contenedor del frontend. El entrypoint oficial de la
# imagen nginx sustituye ${API_BACKEND} y ${SERVER_NAME} al arrancar (envsubst).
#
# - Sirve la PWA compilada (dist/) como archivos estaticos.
# - Reenvia /api y /health al backend (mismo origen: sin CORS y con la cookie
#   del refresh SameSite=Strict).
server {
    listen 80;
    server_name ${SERVER_NAME};

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    location /api/ {
        proxy_pass ${API_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${API_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # El service worker nunca se cachea (si no, la PWA no se actualiza)
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Los assets llevan hash en el nombre: cache agresivo
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: rutas del cliente
    location / {
        try_files $uri /index.html;
    }
}
